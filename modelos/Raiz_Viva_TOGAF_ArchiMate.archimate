        <child xsi:type="archimate:DiagramObject" id="m-goal2" targetConnections="mc4 mc6" archimateElement="goal-ruptura"><bounds x="30" y="120" width="230" height="55"/></child>
        <child xsi:type="archimate:DiagramObject" id="m-goal3" targetConnections="mc7" archimateElement="goal-decisao"><bounds x="30" y="195" width="230" height="55"/></child>
        <child xsi:type="archimate:DiagramObject" id="m-req1" archimateElement="req-granular"><bounds x="320" y="25" width="280" height="50"/><sourceConnection xsi:type="archimate:Connection" id="mc5" source="m-req1" target="m-goal1" relationship="r5"/></child>
