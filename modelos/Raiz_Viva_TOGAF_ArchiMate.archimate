      <child xsi:type="archimate:Group" id="m-g1" name="Problema" fillColor="#f5c2c2"><bounds x="20" y="20" width="520" height="210"/>
        <child xsi:type="archimate:DiagramObject" id="m-driver1" archimateElement="driver-desperdicio"><bounds x="20" y="45" width="190" height="55"/><sourceConnection xsi:type="archimate:Connection" id="mc1" source="m-driver1" target="m-assess1" relationship="r1"/></child>
        <child xsi:type="archimate:DiagramObject" id="m-driver2" archimateElement="driver-ruptura"><bounds x="20" y="125" width="190" height="55"/><sourceConnection xsi:type="archimate:Connection" id="mc2" source="m-driver2" target="m-assess2" relationship="r2"/></child>
        <child xsi:type="archimate:DiagramObject" id="m-assess1" targetConnections="mc1" archimateElement="assessment-planilhas"><bounds x="250" y="40" width="240" height="65"/><sourceConnection xsi:type="archimate:Connection" id="mc3" source="m-assess1" target="m-goal1" relationship="r3"/></child>
        <child xsi:type="archimate:DiagramObject" id="m-assess2" targetConnections="mc2" archimateElement="assessment-fragmentacao"><bounds x="250" y="120" width="240" height="65"/><sourceConnection xsi:type="archimate:Connection" id="mc4" source="m-assess2" target="m-goal2" relationship="r4"/></child>
