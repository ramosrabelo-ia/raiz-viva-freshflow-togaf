<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="Raiz Viva Mercados: Arquitetura TOGAF" id="model-raiz-viva" version="5.6.0">
  <folder name="Motivation" id="folder-motivation" type="motivation">
    <element xsi:type="archimate:Stakeholder" id="stakeholder-diretoria" name="Diretoria de Operações"/>
    <element xsi:type="archimate:Stakeholder" id="stakeholder-loja" name="Gerente de Loja"/>
    <element xsi:type="archimate:Stakeholder" id="stakeholder-compras" name="Equipe de Compras"/>
    <element xsi:type="archimate:Driver" id="driver-desperdicio" name="Descarte elevado de perecíveis"/>
    <element xsi:type="archimate:Driver" id="driver-ruptura" name="Ruptura de estoque em produtos frescos"/>
    <element xsi:type="archimate:Assessment" id="assessment-planilhas" name="Previsão por planilhas e experiência individual"/>
    <element xsi:type="archimate:Assessment" id="assessment-fragmentacao" name="PDV, ERP, estoque e promoções não integrados"/>
    <element xsi:type="archimate:Goal" id="goal-descarte" name="Meta: reduzir descarte em 20 por cento"/>
    <element xsi:type="archimate:Goal" id="goal-ruptura" name="Meta: reduzir ruptura em 15 por cento"/>
    <element xsi:type="archimate:Goal" id="goal-decisao" name="Decisão de reposição explicável e auditável"/>
    <element xsi:type="archimate:Requirement" id="req-granular" name="Prever demanda por SKU, loja e dia"/>
    <element xsi:type="archimate:Requirement" id="req-contexto" name="Considerar promoção, clima, validade e sazonalidade"/>
    <element xsi:type="archimate:Requirement" id="req-humano" name="Permitir ajuste humano com justificativa"/>
    <element xsi:type="archimate:Requirement" id="req-operacao" name="Monitorar qualidade, modelo, custo e resultado"/>
    <element xsi:type="archimate:Principle" id="principle-eventos" name="Eventos para atualização, lote para histórico"/>
    <element xsi:type="archimate:Principle" id="principle-humano" name="IA recomenda, responsável aprova exceções"/>
    <element xsi:type="archimate:Outcome" id="outcome-estoque" name="Estoque certo, na loja certa, no momento certo"/>
  </folder>
  <folder name="Strategy" id="folder-strategy" type="strategy">
